# Application
APP_ENV=development
APP_NAME=VitalAI
APP_VERSION=0.1.0
SYNTHETIC_ONLY=true

# Database
DATABASE_URL=postgresql+asyncpg://vitalai:vitalai@db:5432/vitalai

# Auth
JWT_SECRET_KEY=change-me-generate-with-secrets-token_urlsafe
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM provider switch
# Dev: ollama   Staging/Prod: bedrock
LLM_PROVIDER=ollama
LLM_MODEL=gemma2:2b
OLLAMA_BASE_URL=http://ollama:11434

# Bedrock (used only when LLM_PROVIDER=bedrock)
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Cache
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Embeddings  (nomic dev | bedrock prod)
EMBEDDING_PROVIDER=nomic
EMBEDDING_MODEL=nomic-embed-text

# Outlook connector (inbound mail via Microsoft Graph).
# Leave OUTLOOK_ENABLED=false unless this environment should poll a real
# mailbox. Enabling it also withdraws the high-confidence auto-send shortcut in
# email_service.draft_reply(), so every reply requires an approval first.
# Before enabling: run `python scripts/outlook_login.py` once to sign in.
OUTLOOK_ENABLED=false
OUTLOOK_CLIENT_ID=
# /consumers for personal Microsoft accounts; use
# https://login.microsoftonline.com/<tenant-id> for a work/school tenant.
OUTLOOK_AUTHORITY=https://login.microsoftonline.com/consumers
OUTLOOK_TOKEN_CACHE_PATH=.outlook_token_cache.json
OUTLOOK_POLL_INTERVAL_SECONDS=60
OUTLOOK_MAX_MESSAGES_PER_POLL=25
# Fallback recipient when a message arrives with no toRecipients (shared mailbox).
OUTLOOK_MAILBOX_ADDRESS=
