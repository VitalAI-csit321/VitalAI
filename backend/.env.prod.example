# Copy to .env on the box and fill the empty values. Never commit .env.
# Generate secrets with: openssl rand -hex 32
# scripts/deploy.sh --check validates the filled file.

# production refuses to start on synthetic data; staging is correct here.
APP_ENV=staging
SYNTHETIC_ONLY=true

# Public hostname, no scheme. Use localhost for a laptop rehearsal.
SITE_ADDRESS=vitalai-expo.duckdns.org
# The first entry must be https://<SITE_ADDRESS>: form and password-reset
# links in emails are built from it.
CORS_ORIGINS=https://vitalai-expo.duckdns.org

POSTGRES_PASSWORD=
JWT_SECRET_KEY=
# Login and password-reset attempts per visitor address. Everyone on the
# expo's Wi-Fi shares one public address, so the default 5/minute is too
# tight there. Also adjustable under Settings, Security.
LOGIN_RATE_LIMIT=30/minute
MINIO_ACCESS_KEY=vitalai
MINIO_SECRET_KEY=

# No AWS keys: the EC2 instance role supplies them. Without an instance role,
# a Bedrock API key works instead (botocore reads it from the environment):
# AWS_BEARER_TOKEN_BEDROCK=
LLM_PROVIDER=bedrock
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_PROVIDER=nomic

AGENTIC_PIPELINE_ENABLED=true
EMAIL_BOOKING_CONVERSATION_ENABLED=true
PATIENT_FORM_LINK_ENABLED=true
EMAIL_AUTO_SEND_ENABLED=true
APPOINTMENT_REMINDERS_ENABLED=false
INTENT_CHECK_ENABLED=false

OUTLOOK_ENABLED=false
OUTLOOK_CLIENT_ID=
OUTLOOK_AUTHORITY=https://login.microsoftonline.com/consumers
OUTLOOK_TOKEN_CACHE_PATH=.outlook_token_cache.json
OUTLOOK_POLL_INTERVAL_SECONDS=60
OUTLOOK_MAX_MESSAGES_PER_POLL=25
OUTLOOK_MAILBOX_ADDRESS=

TWILIO_ENABLED=false
