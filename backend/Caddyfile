{$SITE_ADDRESS} {
	encode gzip

	@api path /api/* /health /docs* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# The frontend uses BrowserRouter: a refresh on /patients, or a patient
		# opening /register/<token> from an email, must serve index.html.
		try_files {path} /index.html
		file_server
	}
}

# Extra sites kept on the box only, such as the marketing page and the public
# demo (backend/caddy-extra, not in git). No files there is fine.
import /etc/caddy/extra/*.caddy
